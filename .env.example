# ============ DATABASE ============
# Local SQLite (Zero-config dev): file:./dev.db
# Production / Docker PostgreSQL: postgresql://hotel:hotel_secret@db:5432/hotel_management
DATABASE_URL=postgresql://hotel:hotel_secret@db:5432/hotel_management
REDIS_URL=redis://redis:6379

# ============ JWT ============
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# ============ URLS ============
NODE_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMIN_PORT=3001
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
APP_BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============ OAUTH (Social Login) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

# ============ OTP (Twilio) ============
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============ PAYMENT GATEWAYS ============
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/payments/vnpay/callback

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ============ E-INVOICE ============
EINVOICE_API_ENDPOINT=
EINVOICE_API_KEY=
EINVOICE_COMPANY_TAX_CODE=0301234567

# ============ CHANNEL MANAGER (OTA) ============
AGODA_API_KEY=
BOOKING_COM_API_KEY=
TRAVELOKA_API_KEY=
